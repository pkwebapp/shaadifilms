{
  "name": "shaadi-films-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --env-file-if-exists=.env scripts/build.mjs",
    "dev": "node --env-file-if-exists=.env scripts/build.mjs && node --env-file-if-exists=.env scripts/server.mjs",
    "start": "node --env-file-if-exists=.env scripts/server.mjs",
    "check": "node scripts/check.mjs",
    "media": "node scripts/prepare-media.mjs",
    "test": "node --test scripts/server.test.mjs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
